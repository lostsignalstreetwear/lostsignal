PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_ENVIRONMENT=sandbox
FRONTEND_URL=https://your-site.netlify.app
NETLIFY_DATABASE_URL=postgres://your-netlify-database-connection-string
UPS_SHIPPING_MODE=TEST
UPS_CLIENT_ID=your_ups_client_id_here
UPS_CLIENT_SECRET=your_ups_client_secret_here
UPS_ACCOUNT_NUMBER=your_ups_account_number_here
PORT=3000

# Email / notifications (SMTP-compatible provider)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
ORDER_EMAIL_TO=owner@yourdomain.com
ORDER_EMAIL_FROM=orders@yourdomain.com
NEWSLETTER_EMAIL_FROM=orders@yourdomain.com
NEWSLETTER_ADMIN_TOKEN=generate-a-long-random-admin-token
